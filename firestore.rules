rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for validating docId length and safety
    function isValidDocId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Role and status validators
    function isValidRole(role) {
      return role is string && (role == 'principal' || role == 'staff');
    }

    function isValidStatus(status) {
      return status is string && (status == 'active' || status == 'inactive' || status == 'archived' || status == 'transferred');
    }

    // System Status & Heartbeats
    match /system_status/{docId} {
      allow get, write: if isValidDocId(docId);
      allow list: if true;
    }

    // School Profile
    match /school_profile/{docId} {
      allow get, write: if isValidDocId(docId);
      allow list: if true;
    }

    // Users Collection (Principal & Staff profiles)
    // Enforces document ID validity and ensures roles are strictly 'principal' or 'staff'
    match /users/{userId} {
      allow get: if isValidDocId(userId);
      allow list: if true;
      allow create, update: if isValidDocId(userId)
        && (!('role' in request.resource.data) || isValidRole(request.resource.data.role))
        && (!('status' in request.resource.data) || isValidStatus(request.resource.data.status));
      allow delete: if isValidDocId(userId) && userId != 'usr_prin_deepak'; // Principal account is protected from deletion
    }

    // Classes and Sections
    match /classes/{classId} {
      allow get: if isValidDocId(classId);
      allow list: if true;
      allow create, update: if isValidDocId(classId)
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() > 0));
      allow delete: if isValidDocId(classId);
    }

    // Subjects
    match /subjects/{subjectId} {
      allow get: if isValidDocId(subjectId);
      allow list: if true;
      allow create, update: if isValidDocId(subjectId)
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() > 0));
      allow delete: if isValidDocId(subjectId);
    }

    // Periods
    match /periods/{periodId} {
      allow get, write: if isValidDocId(periodId);
      allow list: if true;
    }

    // Teacher Assignments
    match /teacher_assignments/{assignmentId} {
      allow get, write: if isValidDocId(assignmentId);
      allow list: if true;
    }

    // Timetable
    match /timetable/{slotId} {
      allow get, write: if isValidDocId(slotId);
      allow list: if true;
    }

    // Substitutes
    match /substitutes/{subId} {
      allow get, write: if isValidDocId(subId);
      allow list: if true;
    }

    // Students
    match /students/{studentId} {
      allow get: if isValidDocId(studentId);
      allow list: if true;
      allow create, update: if isValidDocId(studentId)
        && (!('fullName' in request.resource.data) || (request.resource.data.fullName is string && request.resource.data.fullName.size() > 0));
      allow delete: if isValidDocId(studentId);
    }

    // Academic Years
    match /academic_years/{yearId} {
      allow get, write: if isValidDocId(yearId);
      allow list: if true;
    }

    // Student Enrollments
    match /student_enrollments/{enrollmentId} {
      allow get, write: if isValidDocId(enrollmentId);
      allow list: if true;
    }

    // Student Daily Attendance
    match /student_attendance/{docId} {
      allow get: if isValidDocId(docId);
      allow list: if true;
      allow create, update: if isValidDocId(docId)
        && (!('date' in request.resource.data) || (request.resource.data.date is string && request.resource.data.date.size() > 0));
      allow delete: if isValidDocId(docId);
    }

    // Staff Daily Attendance
    match /staff_attendance/{docId} {
      allow get: if isValidDocId(docId);
      allow list: if true;
      allow create, update: if isValidDocId(docId)
        && (!('date' in request.resource.data) || (request.resource.data.date is string && request.resource.data.date.size() > 0));
      allow delete: if isValidDocId(docId);
    }

    // Calendar Config
    match /calendar_config/{docId} {
      allow get, write: if isValidDocId(docId);
      allow list: if true;
    }

    // Audit Logs - Strictly Immutable (Append-only)
    match /audit_logs/{logId} {
      allow get, create: if isValidDocId(logId);
      allow list: if true;
      allow update, delete: if false; // Append-only audit trail
    }

    // Default Deny Rule
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
