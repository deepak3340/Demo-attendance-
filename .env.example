# GEMINI_API_KEY: Optional Gemini API key if AI assistance capabilities are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public domain where the applet is hosted (e.g. your Vercel URL).
APP_URL="https://your-app.vercel.app"

# --- FIREBASE CLIENT CONFIGURATION (Vercel Project Settings -> Environment Variables) ---
# Set these in Vercel to connect to your Firebase project.
# Vite requires public client-side variables to be prefixed with VITE_.
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyPlaceholder"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# --- SERVER RUNTIME ---
PORT=3000
NODE_ENV="production"
